{
    "arrowParens": "always",
    "bracketSpacing": true,
    "htmlWhitespaceSensitivity": "css",
    "insertPragma": false,
    "jsxSingleQuote": false,
    "printWidth": 120,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "requirePragma": false,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": false,
    "vueIndentScriptAndStyle": false,
    "endOfLine": "lf",
    "plugins": ["@trivago/prettier-plugin-sort-imports"],
    "importOrderSortSpecifiers": true,
    "importOrder": [
        "^(react$)|(react/(.*))",
        "^(next$)|(next/(.*))",
        "<THIRD_PARTY_MODULES>",
        "^(components$)|(components/(.*))",
        "^([./])|([../])"
    ]
}