{
  "name": "@atg/to-do",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "prettier": "pnpm -r run prettier",
    "prepare": "husky install",
    "prepush": "pnpm run lint && pnpm run prettier && pnpm run test"
  },
  "devDependencies": {
    "husky": "^8.0.0"
  }
}
